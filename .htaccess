# Notbremse für den Fall, dass dieses Verzeichnis im Web landet.
#
# Zeigt eine Domain versehentlich auf den Projektordner selbst, greift sie und
# liefert 403 statt der .env mit Datenbankzugang und APP_KEY. Genau dieser
# Fehler ist auf Webhosting-Paketen leicht gemacht und teuer.
#
# ACHTUNG -- das Verbot vererbt sich:
# Liegt das Projekt innerhalb des Dokumentenstamms (bei STRATO der Normalfall,
# htdocs/wocheneinkauf/), liest Apache diese Datei auf dem Weg zu
# public/index.php mit. Ohne das "Require all granted" in public/.htaccess
# sperrt sie dann die ganze Anwendung aus -- 403 auf jede Adresse.
# Die beiden Dateien gehören zusammen; wer eine anfasst, prüft die andere.
#
# Sie ersetzt nicht das richtige Zielverzeichnis -- sie fängt nur dessen
# Fehlen ab.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
